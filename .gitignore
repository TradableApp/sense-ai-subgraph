# Graph CLI generated artifacts
build/
generated/
# Important: We ignore subgraph.yaml because we generate it from subgraph.template.yaml
subgraph.yaml

# Dependency directories
node_modules/
jspm_packages/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# --- Local Development Data (Docker) ---
# These folders are created by docker-compose to store chain data.
# NEVER commit these.
data/
ipfs/
postgres/

# Per-machine compose overrides. Compose loads these automatically, so a committed one silently
# rewrites every other developer's volume paths. All four names, because the override filename is
# chosen independently of the base file: Compose v2 also auto-loads the Compose Spec's shorter
# `compose.override.*` even though the base here is `docker-compose.yml`.
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

# dotenv environment variables file
.env
.env.*

# Testing
coverage
coverage.json

# Typechain
typechain
typechain-types

# Hardhat files
cache

# MacOS metadata files
.DS_Store
._*

# VS Code directories
.vscode/
*.code-workspace

# --- Testing ---
coverage/
matchstick-coverage.xml
tests/.bin/
tests/.latest.json
# --- Local session tooling ---

# Claude Code — local only
.claude/settings.local.json
.claude/memory/
.mcp.json

.tmux-devfleet/
.dmux/
.dmux-hooks/
.dmux-session/
.claude/PRPs/
